# ==============================================================================
# Global IT Career Navigator - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
*.env
*.pem
*.key

# SQLite & local databases
*.db
*.sqlite
*.sqlite3
it_navigator.db

# Flask & Python instance folder
instance/
.webassets-cache

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs and Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs and temporary files
*.log
logs/
temp/
tmp/
